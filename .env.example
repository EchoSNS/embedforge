# EmbedForge Environment Configuration
# Copy this file to .env and fill in your values

# ─── LLM Provider ───────────────────────────────────────────────────────────
# Options: openai, azure, anthropic
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4

# Azure OpenAI (if LLM_PROVIDER=azure)
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_KEY=your-azure-key
# AZURE_OPENAI_DEPLOYMENT=gpt-4
# AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Anthropic (if LLM_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=sk-ant-your-key
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ─── Plugin Configuration ───────────────────────────────────────────────────
EMBEDFORGE_PLUGIN=stm32_hal

# ─── Optional: STM32 SDK Path (for compilation) ────────────────────────────
# STM32CUBE_F4_PATH=C:/STM32CubeF4

# ─── Optional: RAG ─────────────────────────────────────────────────────────
EMBEDFORGE_ENABLE_RAG=false

# ─── Logging ───────────────────────────────────────────────────────────────
# Options: DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO

# ─── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ─── Cost Control ──────────────────────────────────────────────────────────
# Monthly/session spending cap in USD (leave empty for no limit)
# EMBEDFORGE_BUDGET_USD=5.00

# Override pricing per 1M tokens for custom/private deployments (JSON)
# EMBEDFORGE_COST_OVERRIDES={"my-deployment": {"input": 2.0, "output": 8.0}}

# LLM response cache size (number of prompt/response pairs to keep in memory)
# Default: 100. Set to 0 to disable caching.
# EMBEDFORGE_CACHE_SIZE=100

# ─── Model-per-Stage ───────────────────────────────────────────────────────
# Route specific pipeline stages to cheaper/faster models (JSON)
# Stages: refiner, hardware, software_arch, software_detailed, codegen, review, chat
# EMBEDFORGE_STAGE_MODELS={"refiner": "gpt-4o-mini", "chat": "gpt-4o-mini"}

# ─── Security ──────────────────────────────────────────────────────────────
# Restrict /api/sdk/scan to these directories (semicolon-separated)
# EMBEDFORGE_SDK_ROOTS=C:/STM32CubeF4;D:/SDKs

# Max user input characters before truncation (default: 5000)
# EMBEDFORGE_MAX_INPUT_LENGTH=5000
